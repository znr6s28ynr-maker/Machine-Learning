        "\n",
        "\n",
        "#Creating the dependent and independent variable for the model\n",
        "X = male[[\"Fare\", \"Age\", \"Pclass\"]]\n",
        "y = male[\"Survived\"]\n",
        "\n",
        "#Spliting the data into training and test data, 75/25\n",
        "X_train, X_test, y_train, y_test = train_test_split(X,y,test_size = .25,random_state = 1912)\n",
        "\n",
        "#Building the model using the variables\n",
        "tree_clf = DecisionTreeClassifier(max_depth=3, random_state=42)\n",
